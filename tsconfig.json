{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "target": "ES2020",
    "useDefineForClassFields": true,
    "verbatimModuleSyntax": true,
    "allowJs": true,
    "types": ["vite/client"]
  },
  "include": ["src/**/*", "vite.config.ts", "svelte.config.js"]
}


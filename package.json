{
  "name": "explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:frontend\"",
    "dev:server": "EXPLORER_API_PORT=4176 tsx watch server/index.ts",
    "dev:frontend": "vite dev --host 0.0.0.0 --port 4175",
    "build": "vite build",
    "preview": "vite preview --port 4175",
    "start:server": "NODE_ENV=production tsx server/index.ts",
    "test": "vitest"
  },
  "dependencies": {
    "svelte": "^5.38.1",
    "express": "^4.18.2",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tsconfig/svelte": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "concurrently": "^8.2.2",
    "jsdom": "^24.0.0",
    "svelte-check": "^4.0.0",
    "tslib": "^2.6.2",
    "tsx": "^4.7.0",
    "typescript": "^5.0.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "@testing-library/svelte": "^5.0.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@sveltejs/vite-plugin-svelte-inspector": "^4.0.1"
  }
}


# Script to rebuild and restart the Explorer container
# Works whether the container is already running or not

set -e

echo "🔄 Rebuilding and restarting Explorer..."

# Navigate to Explorer directory
cd "$(dirname "$0")/.." || exit 1

# Pull latest code

            <dt>Buyer</dt>
            <dd>{formatAddress(result.transaction.buyer)}</dd>
          </div>
          <div>
            <dt>Seller</dt>
            <dd>{formatAddress(result.transaction.seller)}</dd>
          </div>
          <div>
            <dt>Quantity</dt>
            <dd>{result.transaction.quantity}</dd>
          </div>
          <div>
            <dt>Amount</dt>

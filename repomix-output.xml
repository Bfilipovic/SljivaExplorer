          </div>
          <div>
            <dt>Parent NFT</dt>
            <dd>{result.part.parent_hash}</dd>
          </div>
          <div>
            <dt>Owner</dt>
            <dd>{formatAddress(result.part.owner)}</dd>
          </div>
          <div>
            <dt>Listing</dt>

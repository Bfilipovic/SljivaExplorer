  type: "TRANSACTION" | "GIFT" | "MINT" | "LISTING_CREATE" | "LISTING_CANCEL" | "NFT_BUY" | "GIFT_CREATE" | "GIFT_CLAIM" | "GIFT_REFUSE" | "GIFT_CANCEL";
  transaction_number?: number;
  listingId?: string;
  reservationId?: string;
  buyer?: string;
  seller?: string;
  nftId?: string;
  quantity?: number;
  chainTx?: string;
  currency?: string;
  amount?: string;
  arweaveTxId?: string;
  timestamp: string;
  storeId?: string;

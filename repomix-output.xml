          </div>
          {#if result.part.storeName}
            <div>
              <dt>Store</dt>
              <dd>{result.part.storeName}</dd>
            </div>
          {/if}
        </dl>
      </div>
      {#if result.nft}
        <div class="card media-card">
          <h3>NFT Metadata</h3>
          {#if result.nft.imageurl}
